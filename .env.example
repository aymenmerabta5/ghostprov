PRISM_ORIGIN=https://prism.openai.com
PRISM_COOKIE_FILE=C:/Users/you/.ghostprov/prism-cookies.json
PRISM_PROJECT_IDS=project-uuid-1,project-uuid-2,project-uuid-3,project-uuid-4
GP_FLEET_MANIFEST_FILE=C:/Users/you/.ghostprov/fleet.json

# Optional stable-port host supervisor (bun run start:supervised).
GP_SUPERVISOR_READY_TIMEOUT_MS=120000
GP_SHUTDOWN_DRAIN_MS=300000
GP_SUPERVISOR_GRACE_MS=330000
GP_SUPERVISOR_REQUEST_WAIT_MS=480000
GP_SUPERVISOR_QUEUE_MAX_REQUESTS=256
GP_SUPERVISOR_QUEUE_MAX_BYTES=67108864
GP_PRISM_SESSION=authenticated
GP_MAX_PROJECTS=4
GP_PROVISION_CONCURRENCY=4
GP_V2_SANDBOX_CAPACITY=128
GP_V2_INITIAL_ACTIVE_PER_SANDBOX=8
GP_V2_MAX_ACTIVE_PER_SANDBOX=8
GP_V2_RESPONSE_MAX_BYTES=67108864
# R3 is the production default and uses the stable R2 wire protocol.
# Set r2 or r1 only for an explicit immutable rollback.
# Apply revision changes with service `config-restart`, never rolling `restart`.
# Rollback drains R2 and acquires a fresh sandbox session in the same listed
# Prism project; it never falls back in place or creates another project.
GP_V2_SIDECAR_REVISION=r3
# Optional exact configured-project overrides (comma-separated project-id=r1|r2|r3).
# GP_V2_SIDECAR_PROJECT_REVISIONS=project-uuid-2=r1
# Release gates (run before deployment):
# bun run check:v2-sidecar-release
# bun run check:v2-sidecar-deno
GP_HEARTBEAT_MS=10000
GP_ROUTER_QUEUE_TIMEOUT_MS=30000

GP_CANDIDATE=1
PORT=18787
GHOSTPROV_API_KEY=GHOST_IS_KING

# Claude Code client variables are exported in the client environment; this
# server file contains only the key GhostProv validates.
GP_ANTHROPIC_OPUS_MODEL=gpt-5.6-sol
GP_ANTHROPIC_SONNET_MODEL=gpt-5.6-terra
GP_ANTHROPIC_HAIKU_MODEL=gpt-5.6-luna
GP_ANTHROPIC_DEFAULT_MODEL=gpt-5.6-sol

# Disposable forwarding verifier; it binds only its separate loopback port.
GP_CLAUDE_VERIFY_PORT=18788
GP_CLAUDE_VERIFY_UPSTREAM=http://127.0.0.1:18787

GP_LOG_LEVEL=info
GP_LOG_DIR=C:/Users/you/.ghostprov/logs
GP_LOG_ROTATE_BYTES=67108864
GP_LOG_RETAIN_FILES=5
GP_LOG_QUEUE_MAX_EVENTS=10000
GP_LOG_QUEUE_MAX_BYTES=8388608
GP_LOG_FLUSH_MS=250
GP_METRICS_INTERVAL_MS=5000
GP_SLOW_REQUEST_MS=10000
GP_SLOW_FIRST_EVENT_MS=5000

GP_MONITOR_ROOT=http://127.0.0.1:18787
GP_MONITOR_INTERVAL_MS=2000
GP_MONITOR_TIMEOUT_MS=5000

GP_V2_DIAGNOSTICS=0
GP_V2_DIAGNOSTICS_INTERVAL_MS=1000
GP_V2_BATCHING=0
GP_LIVE_V2_DIAGNOSTICS=0
GP_V2_DIAGNOSTIC_ROOT=http://127.0.0.1:18787
