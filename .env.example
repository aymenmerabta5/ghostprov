PRISM_ORIGIN=https://prism.openai.com
PRISM_COOKIE_FILE=C:/Users/you/.ghostprov/prism-cookies.json
# No project IDs are required. GhostProv creates and persists an identity-bound
# fleet under ~/.ghostprov/fleets/<identity-fingerprint>/fleet.json.
# GP_FLEET_MANIFEST_FILE=C:/Users/you/.ghostprov/fleets/custom/fleet.json

# Optional stable-port host supervisor (bun run start:supervised).
GP_SUPERVISOR_READY_TIMEOUT_MS=120000
GP_SHUTDOWN_DRAIN_MS=300000
GP_SUPERVISOR_GRACE_MS=330000
GP_SUPERVISOR_REQUEST_WAIT_MS=480000
GP_SUPERVISOR_QUEUE_MAX_REQUESTS=256
GP_SUPERVISOR_QUEUE_MAX_BYTES=67108864
# Authenticated is the production default. GP_ALLOW_ANONYMOUS only permits
# auto mode to create a guest; explicit anonymous mode is itself an opt-in.
GP_PRISM_SESSION=authenticated
GP_ALLOW_ANONYMOUS=0
GP_GUEST_MAX_PROJECTS=1
GP_TARGET_SANDBOXES=8
GP_MAX_PROJECTS=32
GP_PROVISION_CONCURRENCY=4
# Fresh projects have a stricter cap for Y-Sweet and sandbox supervisor cold starts.
GP_COLD_START_CONCURRENCY=2
# Replacement requires this many identical local R8 bootstrap failures plus a
# healthy-fleet majority, a closed outage circuit, and zero continuation binds.
GP_PROJECT_REPLACEMENT_FAILURES=3
GP_V2_SANDBOX_CAPACITY=128
GP_V2_INITIAL_ACTIVE_PER_SANDBOX=8
GP_V2_MAX_ACTIVE_PER_SANDBOX=8
GP_V2_RESPONSE_MAX_BYTES=67108864
# R10 is the production default: R9's persistent supervisor and R2 bulk-v1,
# plus bounded sandbox-side logs. Set r9 for the immediate immutable rollback,
# r8 for the historical 30 s credential window, or r4 for the standard profile.
# Apply revision changes with service `config-restart`, never rolling `restart`.
# Rollback drains R2 and acquires a fresh sandbox session in the same listed
# Prism project; it never falls back in place or creates another project.
GP_V2_SIDECAR_REVISION=r10
# R9/R10 relay bootstrap installs a persistent supervisor. The supervisor owns
# sidecar launch, credentials, recovery, and stop through authenticated control
# messages. Render mode is only for legacy releases.
GP_V2_BOOTSTRAP_LAUNCH_MODE=relay
# direct starts /bin/sh through Prism's authenticated execution API with prompt
# Hiii and no model inference. llm retains the original Codex conversation path.
# git-fsmonitor is an R10-only alternative: a temporary Git hook restores the
# sandbox Git configuration before launching the same persistent supervisor.
# git-ssh-signing is another R10-only alternative using Git SSH-signing
# callbacks and Deno WebCrypto. It needs neither root nor ssh-keygen.
# Selection is explicit: failed or ambiguous launches never change methods.
GP_V2_SUPERVISOR_BOOTSTRAP_MODE=direct
# Hold an otherwise standalone verified terminal receipt for at most 10 ms so
# an immediate follow-up can share its reliable flight. 0 restores eager receipts.
GP_V2_TERMINAL_RECEIPT_COALESCING=1
# Phase-zero credential wait published into the sidecar static config
# (30000 through 600000 ms). Must fit the relay handshake roundtrip.
GP_V2_BOOTSTRAP_TIMEOUT_MS=300000
# Optional exact persisted-project overrides (comma-separated project-id=r1|r2|r3|r4|r5|r6|r7|r8|r9|r10).
# GP_V2_SIDECAR_PROJECT_REVISIONS=project-uuid-2=r7
# Release gates (run before deployment):
# bun run check:v2-sidecar-release
# bun run check:v2-sidecar-release-r9
# bun run check:v2-sidecar-deno-r9
# bun run check:v2-sidecar-release-r10
# bun run check:v2-sidecar-deno-r10
# bun run check:v2-sidecar-deno
GP_HEARTBEAT_MS=10000
# Exact through 2 MiB. Larger histories use the configured base with bounded
# size scaling: 13 MiB gets 750 s and 64 MiB gets 1470 s at this default.
GP_ROUTER_QUEUE_TIMEOUT_MS=180000

GP_CANDIDATE=0
PORT=18787
# Required and explicit. Personal loopback installs may use a private key of
# at least 12 characters; a random 32-byte value remains recommended.
GHOSTPROV_API_KEY=

# Claude Code client variables are exported in the client environment. These
# optional server-side values map Claude model tiers to upstream model IDs.
GP_ANTHROPIC_OPUS_MODEL=gpt-5.6-sol
GP_ANTHROPIC_SONNET_MODEL=gpt-5.6-terra
GP_ANTHROPIC_HAIKU_MODEL=gpt-5.6-luna
GP_ANTHROPIC_DEFAULT_MODEL=gpt-5.6-sol

# Disposable forwarding verifier; it binds only its separate loopback port.
GP_CLAUDE_VERIFY_PORT=18788
GP_CLAUDE_VERIFY_UPSTREAM=http://127.0.0.1:18888

GP_LOG_LEVEL=info
GP_LOG_DIR=C:/Users/you/.ghostprov/logs
GP_LOG_ROTATE_BYTES=67108864
GP_LOG_RETAIN_FILES=5
GP_LOG_QUEUE_MAX_EVENTS=10000
GP_LOG_QUEUE_MAX_BYTES=8388608
GP_LOG_FLUSH_MS=250
GP_METRICS_INTERVAL_MS=5000
GP_SLOW_REQUEST_MS=10000
GP_SLOW_FIRST_EVENT_MS=5000

GP_MONITOR_ROOT=http://127.0.0.1:18787
GP_MONITOR_INTERVAL_MS=2000
GP_MONITOR_TIMEOUT_MS=5000

GP_V2_DIAGNOSTICS=0
GP_V2_DIAGNOSTICS_INTERVAL_MS=1000
GP_V2_BATCHING=1
GP_LIVE_V2_DIAGNOSTICS=0
GP_V2_DIAGNOSTIC_ROOT=http://127.0.0.1:18888

# Dedicated paid continuation verifier (candidate listener is hardcoded to 18888).
GP_PERSISTED_CONTINUATION_LIVE=0
GP_CONTINUATION_TEST_CONFIRM=
GP_CONTINUATION_TEST_PROJECT_IDS=
GP_CONTINUATION_TEST_COOKIE_FILE=
GP_CONTINUATION_TEST_MANIFEST_FILE=.ghostprov/continuation-live-fleet.json
